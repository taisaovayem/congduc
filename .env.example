DATABASE_HOST=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=mysecretpassword
DATABASE_NAME=congduc

# Chỉ dùng khi chạy docker-compose.dev.yml (publish loopback để dev local):
# DATABASE_PORT=5432
# API_PORT=3000
# WEB_PORT=5173
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=http://localhost:3000

# Production Docker: để trống — trình duyệt gọi cùng origin, nginx trong container web proxy /api và /socket.io tới api.
VITE_API_URL=
VITE_WS_URL=

# Docker network reverse proxy (mặc định web_network trên server)
WEB_NETWORK=web_network
