DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=mysecretpassword
DATABASE_NAME=congduc

API_PORT=3000
WEB_PORT=8080

# Production (Docker build web): để trống — trình duyệt gọi cùng origin, nginx trong container web proxy /api và /socket.io tới api.
VITE_API_URL=
VITE_WS_URL=

# Dev Vite trên host hoặc docker-compose.dev.yml:
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=http://localhost:3000

# Docker network reverse proxy (mặc định web_network trên server)
WEB_NETWORK=web_network
